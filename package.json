{
  "name": "mern-estate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon api/index.js",
    "start": "node api/index.js",
    "build": "npm install && npm install --prefix client && npm run build --prefix client",
    "lint": "npm run lint:client && npm run lint:api",
    "lint:client": "cd client && npx eslint . --ext .js,.jsx --max-warnings 0",
    "lint:api": "cd api && npx eslint . --ext .js --max-warnings 0",
    "lint:fix": "npm run lint:fix:client && npm run lint:fix:api",
    "lint:fix:client": "cd client && npx eslint . --ext .js,.jsx --fix",
    "lint:fix:api": "cd api && npx eslint . --ext .js --fix"
  },
  
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "nodemon": "^3.0.1"
  }
}
